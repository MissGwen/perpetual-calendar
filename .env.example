# PostgreSQL connection string used by Prisma and the Auth adapter.
DATABASE_URL=

# Redis connection string used for AI analysis caching.
REDIS_URL=

# DeepSeek API key. Leave empty if you want to keep the app running without AI analysis.
DEEPSEEK_API_KEY=

# Auth.js secret used to sign sessions and tokens.
AUTH_SECRET=

# GitHub OAuth application credentials.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
